# Required for Java backend -> Python AI service authentication (32+ chars)
SATYA_INTERNAL_TOKEN=replace_with_a_long_random_secret_at_least_32_chars
SATYA_AI_DATA_DIR=./data
SATYA_AI_LOG_LEVEL=INFO

# Optional semantic retrieval. Install requirements-advanced.txt first.
SATYA_ENABLE_SEMANTIC=false
SATYA_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional OpenAI-compatible LLM. Keep disabled until credentials are configured.
SATYA_ENABLE_LLM=false
SATYA_LLM_BASE_URL=https://api.openai.com/v1
SATYA_LLM_API_KEY=
SATYA_LLM_MODEL=gpt-4o-mini
SATYA_LLM_TIMEOUT_SECONDS=45
